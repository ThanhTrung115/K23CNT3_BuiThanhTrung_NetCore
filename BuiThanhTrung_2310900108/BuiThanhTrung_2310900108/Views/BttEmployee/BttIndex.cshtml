@model IEnumerable<BuiThanhTrung_2310900108.Models.BttEmployee>

@{
    ViewData["Title"] = "DANH SÁCH NHÂN VIÊN";
    Layout = "~/Views/Shared/_BttLayout.cshtml";
}

<h1>DANH SÁCH NHÂN VIÊN</h1>

<p>
    <a asp-action="BttCreate" class="btn btn-primary">Thêm mới</a>
</p>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.bttEmpId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.bttEmpName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.bttEmpLevel)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.bttEmpStartDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.bttEmpStatus)
            </th>
            <th>Chức năng</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.bttEmpId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.bttEmpName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.bttEmpLevel)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.bttEmpStartDate)
            </td>
            <td>
                @{
                   if (item.bttEmpStatus==true){
                      <span class="badge bg-success">Hoạt động</span>
                   }else{
                      <span class="badge bg-danger">Không hoạt động</span>
                   }
                }
            </td>
            <td>
                    <a asp-action="BttEdit" asp-route-id="@item.bttEmpId" class="btn btn-warning btn-sm">Sửa</a>
                    <a asp-action="BttDetails" asp-route-id="@item.bttEmpId" class="btn btn-info btn-sm text-white">Chi tiết</a>
                    <a asp-action="BttDelete" asp-route-id="@item.bttEmpId" class="btn btn-danger btn-sm">Xóa</a>
            </td>
        </tr>
}
    </tbody>
</table>
