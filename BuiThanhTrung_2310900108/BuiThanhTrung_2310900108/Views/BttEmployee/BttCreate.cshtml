@model BuiThanhTrung_2310900108.Models.BttEmployee

@{
    ViewData["Title"] = "THÊM MỚI NHÂN VIÊN";
    Layout = "~/Views/Shared/_BttLayout.cshtml";
}

<h1>THÊM MỚI NHÂN VIÊN</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="BttCreate">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="bttEmpId" class="control-label"></label>
                <input asp-for="bttEmpId" class="form-control" />
                <span asp-validation-for="bttEmpId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="bttEmpName" class="control-label"></label>
                <input asp-for="bttEmpName" class="form-control" />
                <span asp-validation-for="bttEmpName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="bttEmpLevel" class="control-label"></label>
                <input asp-for="bttEmpLevel" class="form-control" />
                <span asp-validation-for="bttEmpLevel" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="bttEmpStartDate" class="control-label"></label>
                <input asp-for="bttEmpStartDate" class="form-control" />
                <span asp-validation-for="bttEmpStartDate" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="bttEmpStatus" /> @Html.DisplayNameFor(model => model.bttEmpStatus)
                </label>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="BttIndex">Back to List</a>
</div>
