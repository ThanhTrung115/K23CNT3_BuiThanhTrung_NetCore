@model BttLesson10EF.Models.Category

@{
    ViewData["Title"] = "Details";
}

<div class="row">
    <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h1>@ViewData["Title"]</h1>
                </div>
                <div class="card-body">
                    <div class="form-group">
                        <label asp-for="CateId" class="control-label"></label>
                        <input asp-for="CateId" class="form-control" readonly />
                    </div>
                    <div class="form-group">
                        <label asp-for="CateName" class="control-label"></label>
                        <input asp-for="CateName" class="form-control" readonly />
                    </div>
                    <div class="form-group">
                        <label asp-for="CateStaus" class="control-label"></label>
                        <input asp-for="CateStaus" class="form-control" readonly />
                    </div>
                </div>
                <div class="card-footer">
                    <div class="form-group">
                        <a asp-action="BttEdit" asp-route-bttId="@Model?.CateId" class="btn btn-primary">Edit</a>
                    <a asp-action="BttIndex" class="btn btn-secondary">Quay lại</a>
                    </div>
                </div>
            </div>
    </div>
</div>